    {
      "cell_type": "code",
      "source": [
        "jawab = 'ya'\n",
        "hitung = 0\n",
        "while(jawab == 'ya'):\n",
        "  hitung += 1\n",
        "  jawab = input(\"Ulang lagi tidak? \")\n",
        "print(\"Total perulagan: \",hitung)"
      ],
      "metadata": {
        "id": "ypCofYJ0-XYV"
      },
      "execution_count": null,
      "outputs": []
    },
